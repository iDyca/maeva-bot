# Microsoft Graph API (Azure AD App Registration)
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
AZURE_TENANT_ID=your_tenant_id_here

# Boîte mail surveillée
MAIL_USER=maeva@votredomaine.com

# URL de l'application web cible
APP_URL=https://votre-app.com/tickets

# Identifiants de connexion à l'app web
APP_USERNAME=votre_login
APP_PASSWORD=votre_mot_de_passe

# Intervalle de polling en secondes (défaut: 60)
POLLING_INTERVAL=60
